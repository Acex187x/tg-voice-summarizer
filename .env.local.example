# Copy this file to .env.local and fill in your values, then run:
#   npm run setup
#
# The values prefixed with CONVEX_ are populated automatically by
# `npx convex dev` and should already be present in .env.local — leave them
# alone. Only fill in the values below.

# === REQUIRED ===

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID. Only this user can run admin commands and
# get private-chat voices processed. Use /whoami in the bot to find your ID,
# or look it up via @userinfobot.
ADMIN_TELEGRAM_ID=

# OpenAI API key with access to whisper-1 and gpt-4o-mini.
OPENAI_API_KEY=

# === OPTIONAL ===

# OpenRouter API key. Required ONLY if you configure a stage to use
# provider=openrouter via /setmodel in the bot. Transcription always runs
# through OpenAI because OpenRouter doesn't expose Whisper.
# OPENROUTER_API_KEY=

# Comma-separated list of group/chat IDs the bot should listen to. If empty,
# the bot will process voices from every group it is in. To find a chat ID,
# add the bot to the chat and run /whoami in that chat.
# ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
